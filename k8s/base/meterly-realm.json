{
  "realm": "meterly",
  "enabled": true,
  "displayName": "Meterly",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "meterly-web",
      "name": "Meterly SPA login",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://127.0.0.1:4200/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:4200",
        "http://localhost:4200"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "meterly-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "role",
            "claim.name": "role",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "meterly-admin",
      "name": "Meterly tenant user provisioning",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-meterly-admin",
      "enabled": true,
      "serviceAccountClientId": "meterly-admin",
      "clientRoles": {
        "realm-management": [
          "manage-realm",
          "manage-users",
          "query-users",
          "view-users"
        ]
      }
    },
    {
      "username": "admin@meterly.local",
      "email": "admin@meterly.local",
      "firstName": "Meterly",
      "lastName": "Demo",
      "emailVerified": true,
      "enabled": true,
      "attributes": {
        "tenant_id": ["11111111-1111-1111-1111-111111111111"],
        "role": ["TENANT_ADMIN"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "meterly-demo",
          "temporary": false
        }
      ]
    }
  ]
}
